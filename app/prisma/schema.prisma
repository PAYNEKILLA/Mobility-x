generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String        @id @default(cuid())
  role               String
  name               String
  email              String?       @unique
  phone              String?
  verificationStatus String        @default("pending")
  createdAt          DateTime      @default(now())
  deliveries         Delivery[]
  payments           Payment[]
  transactions       Transaction[]
  trips              Trip[]
  vehicles           Vehicle[]
}

model Vehicle {
  id                 String  @id @default(cuid())
  ownerId            String
  type               String
  make               String?
  model              String?
  registrationNumber String? @unique
  maxWeightKg        Float
  maxPackageCount    Int
  verificationStatus String  @default("pending")
  trips              Trip[]
  owner              User    @relation(fields: [ownerId], references: [id])
}

model Package {
  id          String     @id @default(cuid())
  category    String
  weightKg    Float
  lengthCm    Float
  widthCm     Float
  heightCm    Float
  description String?
  deliveries  Delivery[]
}

model Delivery {
  id                   String        @id @default(cuid())
  customerId           String
  packageId            String
  pickupAddress        String
  pickupLatitude       Float
  pickupLongitude      Float
  destinationAddress   String
  destinationLatitude  Float
  destinationLongitude Float
  option               String
  status               String        @default("draft")
  paymentStatus        String        @default("pending")
  requestedPickupTime  DateTime?
  deliveryDeadline     DateTime?
  estimatedPrice       Float?
  currency             String        @default("NGN")
  createdAt            DateTime      @default(now())
  customer             User          @relation(fields: [customerId], references: [id])
  package              Package       @relation(fields: [packageId], references: [id])
  matches              Match[]
  payments             Payment[]
  transactions         Transaction[]
}

model Trip {
  id                    String    @id @default(cuid())
  partnerId             String
  vehicleId             String
  originAddress         String
  originLatitude        Float
  originLongitude       Float
  destinationAddress    String
  destinationLatitude   Float
  destinationLongitude  Float
  departureTime         DateTime
  estimatedArrivalTime  DateTime?
  availablePackageCount Int
  availableWeightKg     Float
  acceptedCategories    String
  status                String    @default("draft")
  matches               Match[]
  partner               User      @relation(fields: [partnerId], references: [id])
  vehicle               Vehicle   @relation(fields: [vehicleId], references: [id])
}

model Match {
  id                    String   @id @default(cuid())
  deliveryId            String
  tripId                String?
  partnerId             String
  compatibilityScore    Int
  routeCompatibility    Int
  timeCompatibility     Int
  detourDistanceKm      Float
  estimatedExtraMinutes Int
  status                String   @default("offered")
  createdAt             DateTime @default(now())
  delivery              Delivery @relation(fields: [deliveryId], references: [id])
  trip                  Trip?    @relation(fields: [tripId], references: [id])

  @@index([deliveryId])
  @@index([tripId])
}

model Payment {
  id                String        @id @default(cuid())
  deliveryId        String
  customerId        String
  amount            Float
  currency          String
  status            String        @default("pending")
  provider          String?
  providerReference String?
  heldAt            DateTime?
  releasedAt        DateTime?
  refundedAt        DateTime?
  createdAt         DateTime      @default(now())
  customer          User          @relation(fields: [customerId], references: [id])
  delivery          Delivery      @relation(fields: [deliveryId], references: [id])
  transactions      Transaction[]

  @@index([deliveryId])
}

model Transaction {
  id         String    @id @default(cuid())
  deliveryId String?
  paymentId  String?
  userId     String
  type       String
  amount     Float
  currency   String
  status     String    @default("pending")
  createdAt  DateTime  @default(now())
  delivery   Delivery? @relation(fields: [deliveryId], references: [id])
  payment    Payment?  @relation(fields: [paymentId], references: [id])
  user       User      @relation(fields: [userId], references: [id])

  @@index([deliveryId])
  @@index([paymentId])
  @@index([userId])
}
